# Copy this file to .env, then add your own keys.  Never commit .env.

# `demo` uses deterministic illustrative data and makes no network calls.
# `live` uses You.com first for web/news research, then NSE/company sources and
# user uploads for verification and gap filling. Yahoo chart data is used for
# locally calculated technical indicators.
APP_MODE=demo

# Required in live mode. Create your own You.com Search API key and keep the
# actual value only in your local .env file.
YDC_API_KEY=

# Live extraction/synthesis defaults to Nebius Token Factory. Choose a model ID
# shown by https://api.tokenfactory.nebius.com/v1/models and make sure it supports
# structured JSON output. Demo mode does not use these settings.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
NEBIUS_MODEL=moonshotai/Kimi-K3
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Kimi K3 uses Chat Completions on Nebius. It spends part of this completion
# budget on internal reasoning, so keep low effort and the larger token limit.
NEBIUS_API_STYLE=chat_completions
NEBIUS_REASONING_EFFORT=low
NEBIUS_MAX_TOKENS=16384
# One compact dossier is generated per company, so four slots let all four
# companies complete in one provider wave without a sixteen-call nested fan-out.
LLM_MAX_CONCURRENT_REQUESTS=4
# One initial attempt plus two bounded repairs for invalid structured output.
LLM_MAX_ATTEMPTS=3
# Kimi can take more than two minutes even for a valid structured response.
LLM_REQUEST_TIMEOUT_SECONDS=300

# Optional alternative: set LLM_PROVIDER=openai and configure these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Leave blank to use OpenAI's standard API endpoint.
OPENAI_BASE_URL=

# The app first checks this path. If blank, it also checks the attached-book
# location under ~/Documents/DrVijay/ on this computer.
BOOK_PDF_PATH=
BOOK_INDEX_DIR=data/private/peaceful_investing_chroma

# Optional evidence that you download and supply yourself. Streamlit writes
# uploads into these Git-ignored folders. These are secondary verification and
# gap-fill sources. The app never logs into or scrapes Screener, Economic Times,
# or Moneycontrol.
SCREENER_EXPORT_DIR=data/private/screener_exports
COMPANY_DOCUMENTS_DIR=data/private/company_documents
SHOW_ET_REFERENCE_LINKS=true
SHOW_MONEYCONTROL_REFERENCE_LINKS=true

# Research settings.
TARGET_SYMBOL=PNGJL
TARGET_NAME=P N Gadgil Jewellers Limited
# Leave blank for the frozen demo date or today's date in live mode. Set an
# ISO date (for example 2026-09-02) to reproduce a historical live run.
RESEARCH_AS_OF=
MAX_AUDIT_RETRIES=2
MAX_WORKERS=4
